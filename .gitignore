# Real environment variables: the copy of .env.example with passwords,
# TAMIZ_SECRET_KEY, etc. Only .env.example, which has no values, is committed.
.env

# Private SSH keys and certificates Tamiz uses to log in to the servers.
keys/

# Tamiz data: the SQLite database and secret.key, the key that decrypts the
# stored credentials. The most sensitive part of the project.
data/

# Bytecode Python generates when it runs. It is rebuilt automatically and
# depends on each machine's Python version.
__pycache__/
*.pyc

# pytest cache (which tests failed last time). Local to each machine.
.pytest_cache/

# Virtual environment with the installed packages. It is large and is
# recreated with pip install -r requirements-dev.txt.
.venv/

# Fake WAF for testing the local transport (TAMIZ_LOCAL_ROOTS=$PWD/waf).
# Tamiz writes its contents while you test.
waf/
