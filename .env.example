# Tamiz configuration. Copy this file to .env and uncomment the variables
# you want to change.

# --- Authentication -------------------------------------------------------
# local: users stored in Tamiz (default)
# proxy: a reverse proxy (Authelia, oauth2-proxy, Authentik...) logs users in
# none : no login at all. Only for a lab nobody else can reach.
TAMIZ_AUTH_MODE=local

# Optional: create the first administrator on start instead of using the
# setup code printed in the log. Remove the password from this file afterwards.
#TAMIZ_ADMIN_USER=admin
#TAMIZ_ADMIN_PASSWORD=

# Session length in hours.
#TAMIZ_SESSION_HOURS=12

# Secure cookie: auto (from the request, or X-Forwarded-Proto when it comes
# from a trusted proxy), true or false. Behind HTTPS, set it to true.
#TAMIZ_COOKIE_SECURE=auto

# --- Proxies ------------------------------------------------------------------
# Addresses allowed to send X-Forwarded-For/-Proto and, in proxy mode, the user
# header. With docker-compose, a reverse proxy on the host arrives from the
# Docker network gateway (often 172.17.0.1 or 172.18.0.1): Tamiz logs
# "ignored X-Forwarded-User header from <ip>" when the list is missing it.
#TAMIZ_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Proxy authentication (TAMIZ_AUTH_MODE=proxy) ---------------------------
#TAMIZ_PROXY_USER_HEADER=X-Forwarded-User
#TAMIZ_PROXY_GROUPS_HEADER=X-Forwarded-Groups
#TAMIZ_PROXY_ADMIN_GROUPS=waf-admins
#TAMIZ_PROXY_EDITOR_GROUPS=waf-editors
# Role for users in no listed group: viewer, editor, admin or none (denied).
#TAMIZ_PROXY_DEFAULT_ROLE=viewer

# --- Secrets ----------------------------------------------------------------
# Fernet key that encrypts stored SSH passwords and inline keys. If empty,
# Tamiz generates /data/secret.key on first start. To set your own:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#TAMIZ_SECRET_KEY=

# --- Transports ---------------------------------------------------------------
#TAMIZ_KEYS_DIR=/keys
#TAMIZ_LOCAL_ROOTS=/waf
#TAMIZ_DOCKER_HOST=unix:///var/run/docker.sock
#TAMIZ_COMMAND_TIMEOUT=60

#TAMIZ_LOG_LEVEL=INFO
